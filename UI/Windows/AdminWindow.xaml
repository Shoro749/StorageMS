<Window x:Class="UI.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800" Background="#121212">
    <Grid Background="#121212">
        <Grid.Resources>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Padding" Value="5"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#D2B48C"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#333333"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#888888"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border" Padding="20,10" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D2B48C"/>
                                    <Setter Property="Foreground" Value="#D2B48C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <TabItem Header="КОРИСТУВАЧІ">
                <Grid Margin="10,20,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox Width="250" Height="35" Background="#1E1E1E" Foreground="White" 
                                 BorderBrush="#333333" Padding="10,5" VerticalContentAlignment="Center"/>

                            <ComboBox Width="150" Height="35" Margin="10,0" SelectedIndex="0">
                                <ComboBoxItem Content="Всі ролі"/>
                                <ComboBoxItem Content="Адмін"/>
                                <ComboBoxItem Content="Менеджер"/>
                                <ComboBoxItem Content="Комірник"/>
                            </ComboBox>

                            <Button Content="+ ДОДАТИ" Background="#D2B48C" Foreground="#1E1E1E" 
                                Padding="20,0" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>

                        <DataGrid x:Name="dg_userList" Grid.Row="1" Background="#1E1E1E" 
                              Foreground="White" RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                              BorderThickness="0" GridLinesVisibility="None" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="ПІБ" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="150" IsReadOnly="True"/>

                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ПЕРЕГЛЯД" 
                                                Background="#D2B48C" 
                                                Foreground="#1E1E1E" 
                                                FontSize="10" 
                                                FontWeight="Bold" 
                                                Padding="5,2" 
                                                BorderThickness="0" 
                                                Cursor="Hand" Click="Details_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border x:Name="b_detailsPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                        Width="380" Background="#1E1E1E" CornerRadius="15" Padding="25" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="РЕДАГУВАННЯ" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                                    Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" Click="CloseDetails_Click"/>
                            </Grid>

                            <TextBlock Text="Повне ім'я" Foreground="#888888" Margin="0,10,0,5"/>
                            <TextBox Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Роль" Foreground="#888888" Margin="0,15,0,5"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Адмін"/>
                                <ComboBoxItem Content="Менеджер"/>
                                <ComboBoxItem Content="Комірник"/>
                            </ComboBox>

                            <TextBlock Text="Новий пароль" Foreground="#888888" Margin="0,15,0,5"/>
                            <PasswordBox Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <UniformGrid Columns="2" Margin="0,40,0,0">
                                <Button Content="ЗБЕРЕГТИ" Background="#D2B48C" Margin="0,0,5,0" Height="40" 
                                    BorderThickness="0" FontWeight="Bold" Foreground="#1E1E1E"/>
                                <Button Content="ВИДАЛИТИ" Background="#442222" Foreground="#FF6666" 
                                    Margin="5,0,0,0" Height="40" BorderThickness="0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="СКЛАД"/>
        </TabControl>
    </Grid>
</Window>
