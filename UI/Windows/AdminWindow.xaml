<Window x:Class="UI.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800" Background="#121212">
    <Grid Background="#121212">
        <Grid.Resources>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Padding" Value="5"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#D2B48C"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#333333"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#888888"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border" Padding="20,10" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D2B48C"/>
                                    <Setter Property="Foreground" Value="#D2B48C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5"/>
                <Style.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DatePickerTextBox">
                                    <Border Background="{TemplateBinding Background}" 
                    BorderThickness="0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter x:Name="PART_Watermark" 
                                  Content="{TemplateBinding Text}" 
                                  VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Style.Resources>
            </Style>

            <Style TargetType="Button" x:Key="DatePickerCalendarButtonStyle">
                <Setter Property="Background" Value="#D2B48C"/>
            </Style>
        </Grid.Resources>

        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <TabItem Header="КОРИСТУВАЧІ">
                <Grid Margin="10,20,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBox x:Name="tb_userNameSearch" Width="250" Height="35" Background="#1E1E1E" 
                                     Foreground="White" BorderBrush="#333333" Padding="10,5" 
                                     VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged"/>

                                <ComboBox x:Name="cb_filterRoles" Width="150" Height="35" Margin="10,0" 
                                     SelectedIndex="0" SelectionChanged="OnFilterChanged"/>

                                <Button Content="+ ДОДАТИ" Background="#D2B48C" Foreground="#1E1E1E" 
                                    Padding="20,0" Height="35" FontWeight="Bold" BorderThickness="0" 
                                    Cursor="Hand" Click="CreateUser_Click"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" Background="#E53935" Foreground="White" 
                                Padding="20,0" Height="35" FontWeight="Bold" BorderThickness="0" 
                                Cursor="Hand" Click="Logout_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ВИЙТИ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="dg_userList" Grid.Row="1" Background="#1E1E1E" 
                              Foreground="White" RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                              BorderThickness="0" GridLinesVisibility="None" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ім'я" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="150" IsReadOnly="True"/>

                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ПЕРЕГЛЯД" 
                                                Background="#D2B48C" 
                                                Foreground="#1E1E1E" 
                                                FontSize="10" 
                                                FontWeight="Bold" 
                                                Padding="5,2" 
                                                BorderThickness="0" 
                                                Cursor="Hand" Click="Details_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border x:Name="b_detailsPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                        Width="380" Background="#1E1E1E" CornerRadius="15" Padding="25" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="РЕДАГУВАННЯ" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                                    Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" Click="CloseDetails_Click"/>
                            </Grid>

                            <TextBlock Text="Повне ім'я" Foreground="#888888" Margin="0,10,0,5"/>
                            <TextBox x:Name="tb_name" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Роль" Foreground="#888888" Margin="0,15,0,5"/>
                            <ComboBox x:Name="cb_userRole" HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Новий пароль" Foreground="#888888" Margin="0,15,0,5"/>
                            <PasswordBox x:Name="pb_userPassword" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <UniformGrid Columns="2" Margin="0,40,0,0">
                                <Button Content="ЗБЕРЕГТИ" Background="#D2B48C" Margin="0,0,5,0" Height="40" 
                                    BorderThickness="0" FontWeight="Bold" Foreground="#1E1E1E" Click="EditUser_Click"/>
                                <Button Content="ВИДАЛИТИ" Background="#442222" Foreground="#FF6666" 
                                    Margin="5,0,0,0" Height="40" BorderThickness="0" Click="DeleteUser_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="b_createUserPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                        Width="380" Background="#1E1E1E" CornerRadius="15" Padding="25" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="НОВИЙ КОРИСТУВАЧ" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                                Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" 
                                Click="CloseCreatePanel_Click"/>
                            </Grid>

                            <TextBlock Text="Логін / Повне ім'я" Foreground="#888888" Margin="0,10,0,5"/>
                            <TextBox x:Name="tb_createName" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Роль" Foreground="#888888" Margin="0,15,0,5"/>
                            <ComboBox x:Name="cb_createRole" HorizontalAlignment="Stretch" 
                                DisplayMemberPath="Name"/>

                            <TextBlock Text="Пароль" Foreground="#888888" Margin="0,15,0,5"/>
                            <PasswordBox x:Name="pb_createPassword" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Підтвердьте пароль" Foreground="#888888" Margin="0,15,0,5"/>
                            <PasswordBox x:Name="pb_confirmPassword" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <Button Content="СТВОРИТИ" Background="#D2B48C" Margin="0,40,0,0" Height="40" 
                                BorderThickness="0" FontWeight="Bold" Foreground="#1E1E1E" 
                                Click="ConfirmCreateUser_Click"/>

                            <TextBlock Text="* Всі поля обов'язкові" Foreground="#555555" FontSize="10" 
                                HorizontalAlignment="Center" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="ЗВІТИ">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ГЕНЕРАЦІЯ ЗВІТІВ" Foreground="#D2B48C" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                            <TextBlock Text="Тип звіту" Foreground="#888888" FontSize="10" Margin="5,0,0,2"/>
                            <ComboBox x:Name="cb_ReportType" Height="35" Margin="0,0,0,15" SelectedIndex="0" SelectionChanged="OnReportTypeChanged">
                                <ComboBoxItem Content="Залишки на складі"/>
                                <ComboBoxItem Content="Надходження (Incoming)"/>
                                <ComboBoxItem Content="Відвантаження (Outgoing)"/>
                                <ComboBoxItem Content="Журнал дій (Audit)"/>
                            </ComboBox>

                            <TextBlock Text="Період" Foreground="#888888" FontSize="10" Margin="5,0,0,2"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="dp_ReportStart" Grid.Column="0" Height="35" Margin="0,0,2,0"/>
                                <DatePicker x:Name="dp_ReportEnd" Grid.Column="1" Height="35" Margin="2,0,0,0"/>
                            </Grid>

                            <Button Content="📊 СФОРМУВАТИ ПЕРЕГЛЯД" Background="#333333" Foreground="White" 
                        Height="40" Margin="0,10,0,10" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="GeneratePreview_Click"/>

                            <Separator Background="#333333" Margin="0,10"/>

                            <TextBlock Text="ЕКСПОРТ НАКЛАДНИХ" Foreground="#D2B48C" FontWeight="Bold" FontSize="14" Margin="0,10,0,15"/>

                            <Button Content="📄 ПРИБУТКОВА (DOCX)" Background="#2D3E2D" Foreground="#81C784" 
                        Height="40" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#4CAF50"
                        Click="ExportIncomingPDF_Click"/>

                            <Button Content="📄 ВИДАТКОВА (DOCX)" Background="#3E2D2D" Foreground="#E57373" 
                        Height="40" BorderThickness="1" BorderBrush="#F44336"
                        Click="ExportOutgoingPDF_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="lbl_ReportTitle" Text="Попередній перегляд звіту" 
                           Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <DataGrid x:Name="dg_ReportPreview" Grid.Row="1" Background="#252525" Foreground="White"
                          RowBackground="#252525" BorderThickness="0" AutoGenerateColumns="True"
                          IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                <Button Content="ЕКСПОРТ" Background="Transparent" Foreground="#D2B48C" 
                            Padding="20,0" Height="35" BorderBrush="#D2B48C" BorderThickness="1" Click="PrintReport_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="ЛОГИ">
                <Grid Margin="10,20,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Пошук за дією" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <TextBox x:Name="tb_logSearch" Width="250" Height="35" Background="#1E1E1E" 
                             Foreground="White" BorderBrush="#333333" Padding="10,5" 
                             VerticalContentAlignment="Center" TextChanged="OnLogFilterChanged"/>
                            </StackPanel>

                            <StackPanel Margin="10,0">
                                <TextBlock Text="Дата" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <DatePicker x:Name="dp_logDate" Width="150" Height="35" 
                                SelectedDateChanged="OnLogFilterChanged"/>
                            </StackPanel>

                            <Button Content="🗑 ОЧИСТИТИ ВСЕ" Background="#442222" Foreground="#FF6666" 
                        Padding="15,0" Height="35" VerticalAlignment="Bottom"
                        FontWeight="Bold" BorderThickness="1" BorderBrush="#663333"
                        Cursor="Hand" Click="ClearAllLogs_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="dg_logList" Grid.Row="1" Background="#1E1E1E" 
                      Foreground="White" RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                      BorderThickness="0" GridLinesVisibility="None" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Час" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm:ss\}}" Width="150"/>
                                <DataGridTextColumn Header="Користувач" Binding="{Binding User.Name}" Width="150"/>
                                <DataGridTextColumn Header="Дія" Binding="{Binding Action}" Width="*"/>

                                <DataGridTemplateColumn Header="Дії" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="ДЕТАЛІ" Background="#D2B48C" Foreground="#1E1E1E" 
                                            FontSize="10" FontWeight="Bold" Padding="8,2" BorderThickness="0" 
                                            Cursor="Hand" Click="LogDetails_Click" Margin="0,0,5,0"/>

                                                <Button Content="ВИДАЛИТИ" Background="Transparent" Foreground="#FF6666" 
                                            FontSize="10" FontWeight="Bold" Cursor="Hand" 
                                            Click="DeleteLog_Click" BorderThickness="0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border x:Name="b_logDetailsPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                Width="400" Background="#1E1E1E" CornerRadius="15" Padding="25" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="ДЕТАЛІ ПОДІЇ" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                            Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" Click="CloseLogDetails_Click"/>
                            </Grid>

                            <TextBlock Text="Точний час" Foreground="#888888" Margin="0,10,0,5"/>
                            <Border Background="#2D2D2D" Padding="10" CornerRadius="5">
                                <TextBlock x:Name="tb_logDetailTime" Foreground="White" FontSize="14"/>
                            </Border>

                            <TextBlock Text="Виконавець" Foreground="#888888" Margin="0,15,0,5"/>
                            <Border Background="#2D2D2D" Padding="10" CornerRadius="5">
                                <TextBlock x:Name="tb_logDetailUser" Foreground="White" FontSize="14"/>
                            </Border>

                            <TextBlock Text="Опис дії" Foreground="#888888" Margin="0,15,0,5"/>
                            <Border Background="#2D2D2D" Padding="10" CornerRadius="5" MinHeight="100">
                                <TextBlock x:Name="tb_logDetailAction" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                            </Border>

                            <Button Content="ЗАКРИТИ" Background="#333333" Foreground="White" 
                        Margin="0,40,0,0" Height="40" BorderThickness="0" 
                        FontWeight="Bold" Cursor="Hand" Click="CloseLogDetails_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="ТОВАРИ">
                <Grid Margin="10,20,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Пошук назви" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <TextBox x:Name="tb_productNameSearch" Width="200" Height="35" Background="#1E1E1E" 
                             Foreground="White" BorderBrush="#333333" Padding="10,5" 
                             VerticalContentAlignment="Center" TextChanged="OnProductFilterChanged"/>
                            </StackPanel>

                            <StackPanel Margin="10,0">
                                <TextBlock Text="Статус залишків" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <ComboBox x:Name="cb_filterStockStatus" Width="150" Height="35" SelectedIndex="0" 
                              SelectionChanged="OnProductFilterChanged">
                                    <ComboBoxItem Content="All products"/>
                                    <ComboBoxItem Content="OK"/>
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Out of stock"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Content="+ НОВИЙ ТОВАР" Background="#D2B48C" Foreground="#1E1E1E" 
                        Padding="20,0" Height="35" VerticalAlignment="Bottom"
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CreateProduct_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="dg_productList" Grid.Row="1" Background="#1E1E1E" 
          Foreground="White" RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
          BorderThickness="0" GridLinesVisibility="None" AutoGenerateColumns="False"
          CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Мін. залишок" Binding="{Binding MinimumStock}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Залишок" Binding="{Binding Stock}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Од. вим." Binding="{Binding Unit}" Width="80" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Статус" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="OK">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Low">
                                                                <Setter Property="Foreground" Value="#FFB300"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Out of stock">
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Дії" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="РЕДАГУВАТИ" Background="#D2B48C" Foreground="#1E1E1E" 
                            FontSize="10" FontWeight="Bold" Padding="5,2" BorderThickness="0" 
                            Cursor="Hand" Click="ProductDetails_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border x:Name="b_productDetailsPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                Width="380" Background="#1E1E1E" CornerRadius="15" Padding="25" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="РЕДАГУВАННЯ ТОВАРУ" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                            Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" Click="CloseProductDetails_Click"/>
                            </Grid>

                            <TextBlock Text="Назва товару" Foreground="#888888" Margin="0,10,0,5"/>
                            <TextBox x:Name="tb_productEditName" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Одиниця виміру (шт, кг, м)" Foreground="#888888" Margin="0,15,0,5"/>
                            <TextBox x:Name="tb_productEditUnit" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Мінімальний поріг (для сповіщень)" Foreground="#888888" Margin="0,15,0,5"/>
                            <TextBox x:Name="tb_productEditMinStock" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <UniformGrid Columns="2" Margin="0,40,0,0">
                                <Button Content="ЗБЕРЕГТИ" Background="#D2B48C" Margin="0,0,5,0" Height="40" 
                            BorderThickness="0" FontWeight="Bold" Foreground="#1E1E1E" Click="EditProductSave_Click"/>
                                <Button Content="ВИДАЛИТИ" Background="#442222" Foreground="#FF6666" 
                            Margin="5,0,0,0" Height="40" BorderThickness="0" Click="DeleteProduct_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="b_createProductPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                Width="380" Background="#1E1E1E" CornerRadius="15" Padding="25" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="НОВИЙ ТОВАР" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                            Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" Click="CloseCreateProduct_Click"/>
                            </Grid>

                            <TextBlock Text="Назва товару" Foreground="#888888" Margin="0,10,0,5"/>
                            <TextBox x:Name="tb_createProductName" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Одиниця виміру" Foreground="#888888" Margin="0,15,0,5"/>
                            <TextBox x:Name="tb_createProductUnit" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <TextBlock Text="Початковий залишок" Foreground="#888888" Margin="0,15,0,5"/>
                            <TextBox x:Name="tb_createProductStock" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="10"/>

                            <Button Content="СТВОРИТИ" Background="#D2B48C" Margin="0,40,0,0" Height="40" 
                        BorderThickness="0" FontWeight="Bold" Foreground="#1E1E1E" Click="ConfirmCreateProduct_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
