<Window x:Class="UI.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800" Background="#121212">
    <Grid Margin="20">
        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="УПРАВЛІННЯ КОРИСТУВАЧАМИ" 
                   Foreground="#D2B48C" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox Width="250" Height="35" Background="#1E1E1E" Foreground="White" 
                     BorderBrush="#333333" Padding="10,5" VerticalContentAlignment="Center"
                     Tag="Пошук за ім'ям..."/>

                <ComboBox Width="150" Height="35" Margin="10,0" Background="#1E1E1E" 
                      Foreground="White" BorderBrush="#333333" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Всі ролі" IsSelected="True"/>
                    <ComboBoxItem Content="Адмін"/>
                    <ComboBoxItem Content="Комірник"/>
                </ComboBox>

                <Button Content="+ Додати" Background="#D2B48C" Foreground="#1E1E1E" 
                    Padding="20,0" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>

            <DataGrid Grid.Row="2" Background="#1E1E1E" Foreground="White" 
                  RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                  BorderThickness="0" GridLinesVisibility="None" AutoGenerateColumns="False"
                  CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="ПІБ" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="150"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Деталі" Background="Transparent" Foreground="#D2B48C" BorderThickness="0" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border x:Name="DetailsPanel" 
            Visibility="Visible" 
            HorizontalAlignment="Right" 
            Width="400" 
            Background="#1E1E1E" 
            CornerRadius="10,0,0,10" 
            Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <Grid>
                    <TextBlock Text="Інформація про профіль" Foreground="#D2B48C" 
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                        Foreground="#888888" BorderThickness="0" FontSize="18"/>
                </Grid>

                <Separator Background="#333333" Margin="0,20"/>

                <Ellipse Width="80" Height="80" Fill="#2D2D2D" Margin="0,0,0,20"/>

                <TextBlock Text="Повне ім'я" Foreground="#888888" Margin="0,10,0,5"/>
                <TextBox Text="Іван Комірник" Background="#2D2D2D" Foreground="White" 
                     BorderThickness="0" Padding="10"/>

                <TextBlock Text="Електронна пошта" Foreground="#888888" Margin="0,15,0,5"/>
                <TextBox Text="ivan@warehouse.com" Background="#2D2D2D" Foreground="White" 
                     BorderThickness="0" Padding="10"/>

                <TextBlock Text="Доступ до складів" Foreground="#888888" Margin="0,15,0,5"/>
                <CheckBox Content="Склад №1 (Основний)" Foreground="White" Margin="0,8"/>
                <CheckBox Content="Склад №2 (Холодильник)" Foreground="White" Margin="0,8"/>

                <UniformGrid Columns="2" Margin="0,40,0,0">
                    <Button Content="Зберегти" Background="#D2B48C" Margin="0,0,5,0" Height="40" BorderThickness="0" FontWeight="Bold"/>
                    <Button Content="Видалити" Background="#442222" Foreground="#FF6666" Margin="5,0,0,0" Height="40" BorderThickness="0"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
