<Window x:Class="UI.Windows.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        mc:Ignorable="d"
        Title="ManagerWindow" Height="450" Width="800">
    
    <Grid Background="#121212">
        <Grid.Resources>
            <Style x:Name="StatCard" TargetType="Border">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="BorderThickness" Value="0,0,0,3"/>
                <Setter Property="BorderBrush" Value="#333333"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#888888"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border" Padding="20,10" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D2B48C"/>
                                    <Setter Property="Foreground" Value="#D2B48C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#D2B48C"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#333333"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>

                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#D2B48C" StrokeThickness="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </Grid>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom">
                                    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" MinWidth="{TemplateBinding ActualWidth}">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D2B48C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Gd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Gd" Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="#D2B48C"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Gd" Property="Background" Value="#44D2B48C"/>
                                    <Setter Property="Foreground" Value="#D2B48C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#D2B48C"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <BulletDecorator Background="Transparent">
                                <BulletDecorator.Bullet>
                                    <Border x:Name="Box" Width="18" Height="18" 
                                Background="#2D2D2D" BorderBrush="#333333" 
                                BorderThickness="1" CornerRadius="3">
                                        <Path x:Name="CheckMark" Data="M0,4 L3,7 L8,0" 
                                  Stroke="#D2B48C" StrokeThickness="2" 
                                  Margin="3" Visibility="Collapsed"/>
                                    </Border>
                                </BulletDecorator.Bullet>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </BulletDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#D2B48C"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5"/>
                <Style.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DatePickerTextBox">
                                    <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter x:Name="PART_Watermark" 
                                              Content="{TemplateBinding Text}" 
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Style.Resources>
            </Style>

            <Style TargetType="Button" x:Key="DatePickerCalendarButtonStyle">
                <Setter Property="Background" Value="#D2B48C"/>
            </Style>
        </Grid.Resources>

        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <TabItem Header="DASHBOARD">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <Grid Margin="10,0,10,20">
                            <TextBlock Text="ОГЛЯД СКЛАДУ" Foreground="#D2B48C" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Background="#D2B48C" Foreground="#1E1E1E" 
                                    Padding="20,10" FontWeight="Bold" BorderThickness="0" 
                                    Cursor="Hand" Click="Refresh_Click" Margin="0,0,10,0">
                                    <TextBlock Text="ОНОВИТИ" VerticalAlignment="Center"/>
                                </Button>

                                <Button Background="#E53935" Foreground="White" 
                                    Padding="20,10" FontWeight="Bold" BorderThickness="0" 
                                    Cursor="Hand" Click="Logout_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ВИЙТИ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3">
                            <Border BorderBrush="#D2B48C">
                                <StackPanel>
                                    <TextBlock Text="УСЬОГО ТОВАРІВ" Foreground="#888888" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="txt_TotalItems" Text="1,248" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,10"/>
                                    <TextBlock Text="позицій на складі" Foreground="#555555" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#E53935">
                                <StackPanel>
                                    <TextBlock Text="КРИТИЧНИЙ ЗАЛИШОК" Foreground="#E53935" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="txt_LowStock" Text="12" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,10"/>
                                    <TextBlock Text="потребують закупівлі" Foreground="#555555" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#4CAF50">
                                <StackPanel>
                                    <TextBlock Text="ЗАЯВКИ СЬОГОДНІ" Foreground="#4CAF50" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="txt_CompletedToday" Text="28" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,10"/>
                                    <TextBlock Text="виконано успішно" Foreground="#555555" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Margin="10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="ОЧІКУЮТЬ ОБРОБКИ (PENDING)" Foreground="#888888" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <DataGrid x:Name="dg_PendingOrders" Background="Transparent" Foreground="White" 
                                          BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                            <DataGridTextColumn Header="Клієнт" Binding="{Binding Client}" Width="*"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                                            <DataGridTemplateColumn Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="ОЧІКУЄ" Foreground="#FFD700" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="12" Margin="10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="МАЛИЙ ЗАЛИШОК" Foreground="#E53935" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <ItemsControl x:Name="ic_LowStockList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="#333333" Padding="5,8">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding Quantity}" Foreground="#E53935" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ЗАПАСИ ТОВАРІВ">
                <Grid Margin="10,20,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Пошук назви" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                            <TextBox x:Name="tb_ProductSearch" Width="250" Height="35" 
                                 Background="#1E1E1E" Foreground="White" BorderBrush="#333333" 
                                 Padding="10,5" VerticalContentAlignment="Center"
                                 TextChanged="OnStockFilterChanged"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,5">
                            <CheckBox x:Name="chb_LowStockOnly" Content="Тільки дефіцит" 
                                  Foreground="#E53935" FontWeight="Bold"
                                  VerticalContentAlignment="Center"
                                  Checked="OnStockFilterChanged" Unchecked="OnStockFilterChanged"/>
                        </StackPanel>

                        <Button Content="ОНОВИТИ СПИСОК" Margin="20,0,0,0" Height="35" Padding="15,0"
                            Background="Transparent" Foreground="#888888" BorderBrush="#333333"
                            Click="Refresh_Click"/>    
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dg_ProductsStock" 
                          Background="#1E1E1E" Foreground="White" RowBackground="#1E1E1E" 
                          AlternatingRowBackground="#252525" BorderThickness="0" 
                          GridLinesVisibility="None" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Назва товару" Binding="{Binding Name}" Width="1.5*"/>

                            <DataGridTemplateColumn Header="Опис" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" 
                                               Foreground="#888888" 
                                               FontSize="12" 
                                               TextWrapping="Wrap" 
                                               VerticalAlignment="Center" 
                                               Padding="5"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Од. вим." Binding="{Binding Unit}" Width="80"/>

                            <DataGridTextColumn Header="Залишок" Binding="{Binding Stock}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Мінімум" Binding="{Binding MinimumStock}" Width="100"/>

                            <DataGridTemplateColumn Header="Статус" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Out of stock">
                                                            <Setter Property="Background" Value="#44E53935"/>
                                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Low">
                                                            <Setter Property="Background" Value="#44FFB300"/>
                                                            <Setter Property="BorderBrush" Value="#FFB300"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter Property="Background" Value="#444CAF50"/>
                                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock FontWeight="Bold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Out of stock">
                                                                <Setter Property="Text" Value="НЕМАЄ"/>
                                                                <Setter Property="Foreground" Value="#FFCDD2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Low">
                                                                <Setter Property="Text" Value="МАЛО"/>
                                                                <Setter Property="Foreground" Value="#FFE082"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="OK">
                                                                <Setter Property="Text" Value="В НОРМІ"/>
                                                                <Setter Property="Foreground" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="ВСІ ЗАЯВКИ">
                <Grid Margin="10,20,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➕ НОВА ЗАЯВКА" Background="#D2B48C" Foreground="#1E1E1E" 
                        FontWeight="Bold" Padding="15,0" Height="35" BorderThickness="0" 
                        Cursor="Hand" Margin="0,0,20,0" Click="CreateOrder_Click"/>

                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Статус" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <ComboBox x:Name="cb_FilterStatus" Width="130" Height="30" 
                              SelectionChanged="OnOrderFilterChanged">
                                    <ComboBoxItem Content="Всі статуси" IsSelected="True"/>
                                    <ComboBoxItem Content="Pending"/>
                                    <ComboBoxItem Content="Completed"/>
                                    <ComboBoxItem Content="Canceled"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Дата" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <DatePicker x:Name="dp_FilterDate" Width="130" Height="30" 
                                SelectedDateChanged="OnOrderFilterChanged"/>
                            </StackPanel>

                            <CheckBox x:Name="chb_MyOrdersOnly" Content="Мої заявки" 
                          Foreground="#D2B48C" VerticalAlignment="Bottom" Margin="10,0,0,8"
                          Checked="OnOrderFilterChanged" Unchecked="OnOrderFilterChanged"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="dg_Orders" 
                          Background="#1E1E1E" Foreground="White" RowBackground="#1E1E1E" 
                          AlternatingRowBackground="#252525" BorderThickness="0" 
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>

                            <DataGridTextColumn Header="Дата створення" 
                            Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" 
                            Width="140"/>

                            <DataGridTemplateColumn Header="Статус" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" BorderThickness="1" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="#33FFD700"/>
                                                            <Setter Property="BorderBrush" Value="#FFD700"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#334CAF50"/>
                                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                                            <Setter Property="Background" Value="#33E53935"/>
                                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Створив" Binding="{Binding CreatedBy.Name}" Width="120"/>

                            <DataGridTextColumn Header="Коментар" Binding="{Binding Comment}" Width="*"/>

                            <DataGridTemplateColumn Header="Дії" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁" ToolTip="Переглянути" Background="Transparent" Foreground="#D2B48C" 
                                BorderThickness="0" FontSize="16" Cursor="Hand" Click="ViewOrder_Click"/>

                                            <Button Content="✏" ToolTip="Редагувати" Background="Transparent" Foreground="#42A5F5" 
                                BorderThickness="0" FontSize="16" Cursor="Hand" Margin="10,0"
                                Click="EditOrder_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="❌" ToolTip="Скасувати" Background="Transparent" Foreground="#E53935" 
                                                BorderThickness="0" FontSize="16" Cursor="Hand" Click="CancelOrder_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="b_orderDetailsPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                        Width="400" Background="#1E1E1E" CornerRadius="15,0,0,15" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock x:Name="tb_detailsOrderId" Text="ЗАЯВКА №00" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                                Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" 
                                Click="CloseOrderDetails_Click"/>   
                            </Grid> 

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Статус" Foreground="#888888" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="tb_detailsStatus" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>

                                    <TextBlock Text="Автор" Foreground="#888888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="tb_detailsAuthor" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                                    <TextBlock Text="Дата створення" Foreground="#888888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="tb_detailsDate" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                                    <TextBlock Text="Склад замовлення" Foreground="#D2B48C" Margin="0,10,0,10" FontWeight="Bold"/>
                                    <ItemsControl x:Name="ic_detailsItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Product.Name}" Foreground="White"/>
                                                        <TextBlock Grid.Column="1" Foreground="#D2B48C">
                                        <Run Text="{Binding Quantity}"/>
                                        <Run Text="{Binding Product.Unit}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Коментар" Foreground="#888888" Margin="0,20,0,5"/>
                                    <TextBlock x:Name="tb_detailsComment" Foreground="White" TextWrapping="Wrap" FontStyle="Italic"/>
