<Window x:Class="UI.Windows.StorekeeperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        mc:Ignorable="d"
        Title="StorekeeperWindow" Height="450" Width="800">
    <Grid Background="#121212">
        <Grid.Resources>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Padding" Value="5"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#D2B48C"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#333333"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#888888"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border" Padding="20,10" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D2B48C"/>
                                    <Setter Property="Foreground" Value="#D2B48C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="DatePickerCalendarButtonStyle">
                <Setter Property="Background" Value="#D2B48C"/>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5"/>
                <Style.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DatePickerTextBox">
                                    <Border Background="{TemplateBinding Background}" 
        BorderThickness="0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter x:Name="PART_Watermark" 
                      Content="{TemplateBinding Text}" 
                      VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Style.Resources>
            </Style>
        </Grid.Resources>

        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <TabItem Header="ТОВАРИ">
                <Grid Margin="10,20,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Пошук назви" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <TextBox x:Name="tb_ProductSearch" Width="250" Height="35" 
                     Background="#1E1E1E" Foreground="White" BorderBrush="#333333" 
                     Padding="10,5" VerticalContentAlignment="Center"
                     TextChanged="OnStockFilterChanged"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,5">
                                <CheckBox x:Name="chb_LowStockOnly" Content="Тільки дефіцит" 
                      Foreground="#E53935" FontWeight="Bold"
                      VerticalContentAlignment="Center"
                      Checked="OnStockFilterChanged" Unchecked="OnStockFilterChanged"/>
                            </StackPanel>

                            <Button Content="ОНОВИТИ СПИСОК" Margin="20,0,0,0" Height="35" Padding="15,0"
                VerticalAlignment="Bottom"
                Background="Transparent" Foreground="#888888" BorderBrush="#333333"
                Cursor="Hand" Click="Refresh_Click"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="#E53935" Foreground="White" 
            Padding="20,0" Height="35" FontWeight="Bold" BorderThickness="0" 
            Cursor="Hand" Click="Logout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ВИЙТИ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dg_ProductsStock" 
          Background="#1E1E1E" Foreground="White" RowBackground="#1E1E1E" 
          AlternatingRowBackground="#252525" BorderThickness="0" 
          GridLinesVisibility="None" AutoGenerateColumns="False"
          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Назва товару" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Од. вим." Binding="{Binding Unit}" Width="80"/>

                            <DataGridTextColumn Header="Залишок" Binding="{Binding Stock}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Статус" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Out of stock">
                                                            <Setter Property="Background" Value="#44E53935"/>
                                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Low">
                                                            <Setter Property="Background" Value="#44FFB300"/>
                                                            <Setter Property="BorderBrush" Value="#FFB300"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter Property="Background" Value="#444CAF50"/>
                                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="Bold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Out of stock">
                                                                <Setter Property="Text" Value="НЕМАЄ"/>
                                                                <Setter Property="Foreground" Value="#FFCDD2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Low">
                                                                <Setter Property="Text" Value="МАЛО"/>
                                                                <Setter Property="Foreground" Value="#FFE082"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="OK">
                                                                <Setter Property="Text" Value="В НОРМІ"/>
                                                                <Setter Property="Foreground" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Дії" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="+ ПРИХІД" Background="#D2B48C" Foreground="#1E1E1E" 
                                            FontWeight="Bold" FontSize="10" Padding="10,2" Cursor="Hand"
                                            Click="AddStock_Click" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="b_addStockPanel" Visibility="Collapsed" HorizontalAlignment="Right" 
                          Width="350" Background="#1E1E1E" CornerRadius="15" Padding="25" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Direction="180" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,25">
                                <TextBlock Text="НОВА НАКЛАДНА" Foreground="#D2B48C" FontSize="18" FontWeight="Bold"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                                Foreground="#888888" BorderThickness="0" FontSize="20" Cursor="Hand" 
                                Click="CloseStockPanel_Click"/>
                            </Grid>

                            <TextBlock Text="Товар:" Foreground="#888888" Margin="0,0,0,5"/>
                            <TextBlock x:Name="tb_selectedProductName" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                            <TextBlock Text="Кількість надходження:" Foreground="#888888" Margin="0,0,0,5"/>
                            <TextBox x:Name="tb_stockQuantity" Background="#2D2D2D" Foreground="White" 
                 BorderThickness="0" Padding="12" FontSize="16" Margin="0,0,0,30"/>

                            <Button Content="ПРИЙНЯТИ ТОВАР" Background="#D2B48C" Height="45" 
                BorderThickness="0" FontWeight="Bold" Foreground="#1E1E1E" 
                Click="ConfirmAddStock_Click"/>

                            <TextBlock Text="* Кількість додасться до поточного залишку" 
                   Foreground="#555555" FontSize="10" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="НАКЛАДНІ">
                <Grid Margin="10,20,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Пошук товару" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <TextBox x:Name="tb_incomingSearch" Width="200" Height="35" Background="#1E1E1E" 
                             Foreground="White" BorderBrush="#333333" Padding="10,5" 
                             VerticalContentAlignment="Center" TextChanged="OnIncomingFilterChanged"/>
                            </StackPanel>

                            <StackPanel Margin="10,0">
                                <TextBlock Text="Дата отримання" Foreground="#555555" FontSize="10" Margin="5,0,0,2"/>
                                <DatePicker x:Name="dp_incomingDate" Width="150" Height="35" 
                                SelectedDateChanged="OnIncomingFilterChanged"/>
                            </StackPanel>

                            <Button Content="🔄 ОНОВИТИ" Background="Transparent" Foreground="#D2B48C" 
                        BorderBrush="#D2B48C" BorderThickness="1" Padding="15,0" Height="35" 
                        VerticalAlignment="Bottom" Cursor="Hand" Click="RefreshIncoming_Click" Margin="0,0,10,0"/>
                        </StackPanel>

                        <DataGrid x:Name="dg_incomingList" Grid.Row="1" Background="#1E1E1E" 
                      Foreground="White" RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                      BorderThickness="0" GridLinesVisibility="None" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding ReceivedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                                <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*"/>
                                <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Прийняв" Binding="{Binding ReceivedBy.Name}" Width="150"/>

                                <DataGridTemplateColumn Header="Дії" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ВІДМІНИТИ" Background="Transparent" Foreground="#FF6666" 
                                        FontSize="10" FontWeight="Bold" Cursor="Hand" 
                                        Click="DeleteIncoming_Click" BorderThickness="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
