<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="350"
        Background="#121212" ResizeMode="NoResize">
    <Grid>
        <Border Width="350" Height="450" 
                Background="#1E1E1E" 
                CornerRadius="15" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel Margin="30">
                <Path Data="M3,18L7,16.75V7L14,5V19.5L3.5,18.25V18M7,16.75L21,18V5L7,7V16.75Z" 
                      Fill="#D2B48C" Stretch="Uniform" Height="60" Width="60" 
                      Margin="0,20,0,10"/>

                <TextBlock Text="СКЛАД ПРО" 
                           Foreground="#D2B48C" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Вхід у систему" 
                           Foreground="#888888" 
                           FontSize="14" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,30"/>

                <TextBlock Text="Логін" Foreground="#A0A0A0" Margin="0,10,0,5"/>
                <TextBox x:Name="tb_login"
                         Background="#2D2D2D" 
                         Foreground="White" 
                         BorderThickness="0" 
                         Padding="10,8" 
                         FontSize="14"
                         CaretBrush="#D2B48C"/>

                <TextBlock Text="Пароль" Foreground="#A0A0A0" Margin="0,15,0,5"/>
                <PasswordBox x:Name="tb_password"
                             Background="#2D2D2D" 
                             Foreground="White" 
                             BorderThickness="0" 
                             Padding="10,8" 
                             FontSize="14"
                             CaretBrush="#D2B48C"/>

                <Button Content="УВІЙТИ" 
                        Margin="0,30,0,0" 
                        Height="45" 
                        Background="#D2B48C" 
                        Foreground="#1E1E1E" 
                        FontWeight="Bold"
                        Cursor="Hand" Click="Login_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Забули пароль?" 
                           Foreground="#666666" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,0" 
                           Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
